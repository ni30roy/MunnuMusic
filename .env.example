# Neon Postgres connection string — console.neon.tech
DATABASE_URL=

# Auth.js session encryption secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Cloudinary — console.cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# YouTube Data API v3 key — console.cloud.google.com, restricted to YouTube Data API v3
YOUTUBE_API_KEY=

# Required to create a new account on /signup — invite-only gate. Any string.
SIGNUP_INVITE_CODE=
